# Employee Utilization Analytics - Environment Variables
# Copy this file to .env and fill in the values

# Database Configuration (for SQL analytics)
DATABASE_URL=sqlite:///data/analytics.db

# Application Settings
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Data Paths
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
OUTPUT_PATH=output
